# Local development example. Do not reuse these token values in production.
PORT=3000

# Optional static API tokens. In production, use unique high-entropy tokens.
KNITGETHER_API_TOKENS=dev-user:dev-token

# Local development only. DEV_AUTH_TOKEN is ignored when NODE_ENV=production.
DEV_AUTH_TOKEN=dev-token
DEV_AUTH_USER_ID=dev-user

# Required when NODE_ENV=production. Use a long random value.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_EXPIRES_IN_SECONDS=2592000

DATABASE_URL=postgresql://knitgether:knitgether@localhost:5433/knitgether_dev?schema=public
FILE_STORAGE_ROOT=./storage
PATTERN_UPLOAD_MAX_BYTES=52428800
DRAWING_UPLOAD_MAX_BYTES=10485760
