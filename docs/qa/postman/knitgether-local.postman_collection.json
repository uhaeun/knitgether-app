{
  "info": {
    "name": "KnitGether Local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api/v1"
    },
    {
      "key": "token",
      "value": "dev-token",
      "description": "NODE_ENV가 development 또는 test일 때만 서버가 받는 공개 기본값(server/src/auth/api-auth.guard.ts). 비밀값이 아니다."
    },
    {
      "key": "testEmail",
      "value": "",
      "description": "로컬 테스트 계정. Postman 환경 변수로 넣는다. 저장소에 커밋하지 않는다."
    },
    {
      "key": "testPassword",
      "value": "",
      "description": "로컬 테스트 계정 비밀번호. Postman 환경 변수로 넣는다. 저장소에 커밋하지 않는다."
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Auth Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Projects List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/projects"
      }
    },
    {
      "name": "Projects Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{projectId}}\",\n  \"name\": \"QA Cardigan\",\n  \"status\": \"WIP\",\n  \"isFavorite\": false,\n  \"memo\": \"Postman smoke project\",\n  \"startDate\": \"{{startDate}}\",\n  \"relatedSkillIds\": [],\n  \"rowCounter\": {\n    \"id\": \"{{rowCounterId}}\",\n    \"projectId\": \"{{projectId}}\",\n    \"name\": \"메인\",\n    \"currentRow\": 0\n  },\n  \"workSessions\": []\n}"
        },
        "url": "{{baseUrl}}/projects",
        "description": "테스트용 프로젝트를 생성한다. 현재 SaveProjectDto 필수값을 포함한다. 매 요청마다 새 UUID를 생성하므로 재전송 멱등성 검증에는 별도 고정 ID 요청이 필요하다."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"projectId\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.variables.set(\"rowCounterId\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.variables.set(\"startDate\", new Date().toISOString());"
            ]
          }
        }
      ]
    },
    {
      "name": "Patterns List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/patterns"
      }
    },
    {
      "name": "Library Yarns List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/library/yarns"
      }
    },
    {
      "name": "Library Needles List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/library/needles"
      }
    },
    {
      "name": "Library Tools List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/library/tools"
      }
    },
    {
      "name": "Skills List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/skills"
      }
    },
    {
      "name": "Dictionary Terms List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/dictionary-terms"
      }
    },
    {
      "name": "Gauge Records List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/gauge-records"
      }
    },
    {
      "name": "Gauge Targets List",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/gauge-targets"
      }
    }
  ]
}
